<Application x:Class="Fable2Launcher.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Brushes must be defined before the styles that reference them via
       StaticResource. Global styles must live in Application.Styles to be
       applied. They keep the WPF launcher's look: light dropdowns with dark
       text, and no global TextBlock foreground so dropdown text can inherit
       its color. Avalonia uses style classes (Button.primary) where WPF used
       keyed styles. -->

  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#DB121A1C" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFF4E8D2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9DA8A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC69A46" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFE0B55A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#FF172020" />
      <Setter Property="Background" Value="#FFF3EEE4" />
      <Setter Property="BorderBrush" Value="#557C6A48" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="#FF172020" />
      <Setter Property="Background" Value="#FFF3EEE4" />
      <Setter Property="Padding" Value="10,7" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="#FFE4C982" />
        <Setter Property="Foreground" Value="#FF17130B" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="#FFC69A46" />
        <Setter Property="Foreground" Value="#FF17130B" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="#FF17130B" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="24,12" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#332E3B3A" />
      <Setter Property="BorderBrush" Value="#667E8D86" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </Style>

    <!-- WPF's BasedOn is not available in Avalonia: preset buttons use both
         classes (Classes="secondary preset") instead. -->
    <Style Selector="Button.preset">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="98" />
    </Style>
  </Application.Styles>
</Application>
