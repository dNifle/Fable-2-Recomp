# Local Linux portability fixes for the pinned thirdparty/rexglue-sdk checkout.
# Applied idempotently by tools/build_runtime_sdk.sh (Linux flow only; the
# Windows flow builds the pristine submodule). Regenerate after bumping the
# SDK submodule with:
#   git -C thirdparty/rexglue-sdk diff > thirdparty/rexglue-sdk-linux.patch
#
# Contents: (1) presenter.h - host_frame_limiter_ member declared outside the
# REX_PLATFORM_WIN32 block (it is used unconditionally); (2) Vulkan pipeline
# cache - vkCreateGraphicsPipelines used VK_NULL_HANDLE, so the driver
# recompiled every shader permutation per pipeline state (the in-game
# stutters), and no cache was persisted across runs; plus the four core 1.0
# cache functions in the device table. Both are cross-platform improvements
# that belong in the fork eventually.
#
diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
